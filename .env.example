# Telegram (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (both partners).
# Find yours via @userinfobot
ALLOWED_USER_IDS=123456789,987654321

# OpenAI — use the API key from the same OpenAI account that has Codex access.
# ChatGPT Plus alone is NOT enough; you need API access / billing.
OPENAI_API_KEY=
# Model: e.g. gpt-4o, gpt-4.1, o4-mini, or a Codex-capable model if your account exposes one.
OPENAI_MODEL=gpt-4o

# Shared home identity
HOME_NAME=Our Home
BOT_DISPLAY_NAME=Home

# Railway / server
# Leave empty for local long-polling. On Railway set PUBLIC_URL to https://your-app.up.railway.app
PUBLIC_URL=
PORT=8080

# SQLite path (use /data on Railway volume)
DATABASE_PATH=./data/home.db

# Optional: max recent messages kept per chat for context window
MAX_CONTEXT_MESSAGES=40
