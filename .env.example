# Telegram core
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-A-Z-a-z-0-9_-secret
ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_ADMIN_USER_IDS=123456789

# Group allow-list. Keep unlisted groups disabled unless you intentionally want
# every allow-listed household user to activate the bot in arbitrary groups.
ALLOWED_CHAT_IDS=-1001234567890
TELEGRAM_ALLOW_UNLISTED_GROUPS=false
# all | mentions | topics | mention_or_topic
TELEGRAM_GROUP_RESPONSE_MODE=mention_or_topic
# Keep private memory/notes/people/Docs unavailable in groups by default.
TELEGRAM_GROUP_ALLOW_PRIVATE_CONTEXT=false

# Topics and concurrency
TELEGRAM_ALLOW_TOPIC_CREATION=true
TELEGRAM_ENABLE_PRIVATE_TOPICS=true
TELEGRAM_CONCURRENT_UPDATES=16

# Share Anywhere / Inline Mode. BotFather /setinline must also be enabled.
TELEGRAM_INLINE_ENABLED=true
TELEGRAM_INLINE_MAX_RESULTS=20
TELEGRAM_INLINE_CACHE_SECONDS=3
TELEGRAM_INLINE_USAGE_RETENTION_DAYS=30

# Bot API compatibility layer. Stable features use python-telegram-bot; newer
# raw methods stay off until explicitly enabled and tested.
TELEGRAM_RAW_API_ENABLED=false
TELEGRAM_ENABLE_EPHEMERAL_MESSAGES=false
TELEGRAM_ENABLE_RICH_MESSAGES=false
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=

# Household
HOUSEHOLD_ID=primary
HOME_NAME=הבית שלנו
BOT_DISPLAY_NAME=Home
HOUSEHOLD_TIMEZONE=Asia/Jerusalem

# Railway / server. PUBLIC_URL may be omitted on Railway; RAILWAY_PUBLIC_DOMAIN is detected.
PUBLIC_URL=
MINI_APP_URL=
PORT=8080
DATABASE_PATH=/data/home.db
APP_SESSION_SECRET=replace-with-a-long-random-secret
MAX_CONTEXT_MESSAGES=40
VERBATIM_MESSAGES=16
SUMMARY_MODEL=gpt-4o-mini
MAX_INIT_DATA_AGE_SECONDS=3600
SESSION_TTL_SECONDS=86400
LOG_LEVEL=INFO

# Proactivity — reminders, calendar nudges and the morning brief.
# Each key can also be overridden at runtime via the settings table.
PROACTIVE_ENABLED=true
BRIEF_TIME=08:00
QUIET_HOURS=22:30-07:30
CALENDAR_NUDGE_MINUTES=30

# Google (dedicated bot account — OAuth refresh-token flow). The refresh token
# can also be stored by the bootstrap callback in the persistent database.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# One managed root folder for household files, Docs and Sheets. Leave the ID
# empty on first launch to let the bot create and persist the folder automatically.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=Shared Home
# Comma-separated Google accounts that should inherit editor access to the root.
GOOGLE_DRIVE_SHARED_EMAILS=user1@gmail.com,user2@gmail.com
GOOGLE_DRIVE_MAX_UPLOAD_MB=25
# Legacy compatibility. When unset, Docs/Sheets use GOOGLE_DRIVE_FOLDER_ID.
GOOGLE_DOCS_FOLDER_ID=

# Set temporarily to enable the /google/oauth/* bootstrap routes, then unset.
GOOGLE_OAUTH_SETUP_SECRET=
