# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-A-Z-a-z-0-9_-secret
ALLOWED_USER_IDS=123456789,987654321

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=

# Household
HOUSEHOLD_ID=primary
HOME_NAME=הבית שלנו
BOT_DISPLAY_NAME=Home
HOUSEHOLD_TIMEZONE=Asia/Jerusalem

# Railway / server. PUBLIC_URL may be omitted on Railway; RAILWAY_PUBLIC_DOMAIN is detected.
PUBLIC_URL=
MINI_APP_URL=
PORT=8080
DATABASE_PATH=/data/home.db
APP_SESSION_SECRET=replace-with-a-long-random-secret
MAX_CONTEXT_MESSAGES=40
MAX_INIT_DATA_AGE_SECONDS=3600
SESSION_TTL_SECONDS=86400
LOG_LEVEL=INFO

# FastCRW web search, scraping and site mapping. Hosted API requires CRW_API_KEY.
# For self-hosting, set CRW_API_URL=http://your-crw-service:3000; the key is optional
# unless authentication is enabled on that server.
CRW_API_KEY=
CRW_API_URL=https://api.fastcrw.com
CRW_TIMEOUT_SECONDS=30
CRW_MAX_CONTENT_CHARS=16000

# here.now static website publishing. Use a dedicated, revocable API key for this bot.
HERENOW_API_KEY=
HERENOW_API_URL=https://here.now
# Optional workspace account/subdomain. Leave empty to publish to the key owner's account.
HERENOW_ACCOUNT=
HERENOW_TIMEOUT_SECONDS=30
HERENOW_MAX_FILES=12
HERENOW_MAX_SITE_KB=256

# Google (dedicated bot account — OAuth refresh-token flow). Tools appear only
# when CLIENT_ID + CLIENT_SECRET + REFRESH_TOKEN are all set. The refresh token
# can also be stored by the bootstrap callback in the persistent database.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# One managed root folder for household files, Docs and Sheets. Leave the ID
# empty on first launch to let the bot create and persist the folder automatically.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=Shared Home
# Comma-separated Google accounts that should inherit editor access to the root.
GOOGLE_DRIVE_SHARED_EMAILS=user1@gmail.com,user2@gmail.com
GOOGLE_DRIVE_MAX_UPLOAD_MB=25
# Legacy compatibility. When unset, Docs/Sheets use GOOGLE_DRIVE_FOLDER_ID.
GOOGLE_DOCS_FOLDER_ID=

# Set temporarily to enable the /google/oauth/* bootstrap routes, then unset.
GOOGLE_OAUTH_SETUP_SECRET=
